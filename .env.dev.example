# Copy to .env.dev and fill in. .env.dev is gitignored.

# --- LLM (DashScope / Qwen) -------------------------------------------------
DASHSCOPE_API_KEY=
# DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# FOUNDATION_MODEL=qwen3.5-flash
# EMBEDDING_MODEL=text-embedding-v3

# --- Memory backends --------------------------------------------------------
# POSTGRES_URL=postgresql://user:pass@localhost:5432/analyst
# REDIS_URL=redis://localhost:6379

# --- Auth0 (authentication) -------------------------------------------------
# AUTH0_DOMAIN=your-tenant.us.auth0.com
# AUTH0_API_AUDIENCE=
# AUTH0_ISSUER=
# AUTH0_ROLES_CLAIM=https://agentic-data-analyst/roles

# --- Rate limiting ----------------------------------------------------------
# RATE_LIMIT_MAX_REQUESTS=5
# RATE_LIMIT_WINDOW_SECONDS=60

# --- Semantic cache ---------------------------------------------------------
# SEMANTIC_CACHE_DISTANCE=0.1
# SEMANTIC_CACHE_TTL=

# --- Observability (OpenTelemetry / LangSmith) ------------------------------
# LANGSMITH_OTEL_ENABLED=false
# OTEL_EXPORTER_OTLP_ENDPOINT=
# OTEL_SERVICE_NAME=agentic-data-analyst
# LANGSMITH_PROJECT=
# LANGSMITH_API_KEY=
